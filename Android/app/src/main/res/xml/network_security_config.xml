<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Por defecto TODO el tráfico debe ir cifrado (HTTPS): el token JWT viaja en cada petición. -->
    <base-config cleartextTrafficPermitted="false" />

    <!--
      SOLO DESARROLLO: se permite HTTP únicamente hacia el emulador y hacia la PC de pruebas.
      Esta IP debe coincidir con ApiClient.BASE_URL. En producción se elimina este bloque
      y la API se consume por HTTPS con un certificado válido.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.123.5</domain>
        <domain includeSubdomains="false">192.168.18.10</domain>
    </domain-config>
</network-security-config>
