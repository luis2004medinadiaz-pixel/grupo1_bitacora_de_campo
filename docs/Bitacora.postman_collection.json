{
  "info": {
    "name": "Bitacora API",
    "description": "Coleccion de pruebas para la API REST de la bitacora de campo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    }
  ],
  "item": [
    {
      "name": "1. Crear registro (exitoso)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Registro de prueba\",\n  \"descripcion\": \"Descripcion obtenida por voz a texto\",\n  \"fotoBase64\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/registros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "registros"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('registroId', json.id);",
              "pm.test('Location header present', function () {",
              "    pm.expect(pm.response.headers.get('Location')).to.not.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Listar registros (exitoso)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/registros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "registros"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is an array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "pm.test('Items do not include fotoBase64', function () {",
              "    var items = pm.response.json();",
              "    if (items.length > 0) {",
              "        pm.expect(items[0]).to.not.have.property('fotoBase64');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Consultar registro por id (exitoso)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/registros/{{registroId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "registros",
            "{{registroId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response includes fotoBase64 field', function () {",
              "    pm.expect(pm.response.json()).to.have.property('fotoBase64');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Consultar registro por id (fallido - 404)",
      "request": {
        "method": "GET",
