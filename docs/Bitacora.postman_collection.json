        {
          "name": "0.5 Login Usuario A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{usuarioACorreo}}\",\n  \"password\": \"{{usuarioAPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto (200)', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('Devuelve token, expiraEn y rol', function () {",
                  "  pm.expect(j.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.expiraEn).to.be.a('string');",
                  "  pm.expect(j.rol).to.be.oneOf(['Admin','Usuario']);",
                  "});",
                  "pm.collectionVariables.set('tokenUsuario', j.token);",
                  "// Se guarda una copia del primer token para la prueba de 'token vencido' (ver README).",
                  "if (!pm.collectionVariables.get('tokenVencido')) { pm.collectionVariables.set('tokenVencido', j.token); }",
                  "pm.collectionVariables.set('usuarioAId', j.usuarioId);"
                ]
              }
            }
          ]
        },
