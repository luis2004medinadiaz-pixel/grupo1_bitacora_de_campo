    {
      "name": "2. CRUD de registros (con token)",
      "item": [
        {
          "name": "1. Crear registro (exitoso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Registro de prueba\",\n  \"descripcion\": \"Descripcion obtenida por voz a texto\",\n  \"fotoBase64\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/registros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registros"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUsuario}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('registroId', json.id);",
                  "pm.test('Location header present', function () {",
                  "    pm.expect(pm.response.headers.get('Location')).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Listar registros (exitoso)",
          "request": {
            "method": "GET",
