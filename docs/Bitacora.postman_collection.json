    {
      "name": "1. Pruebas obligatorias de seguridad",
      "item": [
        {
          "name": "1.0 (preparación) Usuario A crea un registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Registro de Usuario A\",\n  \"descripcion\": \"Registro para las pruebas de autorización\",\n  \"fotoBase64\": null\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUsuario}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json(); pm.collectionVariables.set('registroPruebaId', j.id);",
                  "pm.test('Guarda al usuario creador', function () { pm.expect(j.usuarioId).to.eql(Number(pm.collectionVariables.get('usuarioAId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.1 Petición SIN token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
