                  "pm.test('Código 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('El mensaje indica que venció', function () { pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('expired'); });"
                ]
              }
            }
          ]
        },
