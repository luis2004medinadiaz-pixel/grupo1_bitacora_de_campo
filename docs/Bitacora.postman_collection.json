        {
          "name": "1.4 Token ALTERADO → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registros"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlterado}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cambia un carácter de la firma: el token deja de ser válido.",
                  "var t = pm.collectionVariables.get('tokenUsuario') || '';",
                  "var p = t.split('.');",
                  "if (p.length === 3) { var s = p[2]; var i = 5; p[2] = s.substring(0,i) + (s.charAt(i) === 'A' ? 'B' : 'A') + s.substring(i+1); }",
                  "pm.collectionVariables.set('tokenAlterado', p.join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Token VENCIDO → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registros"
