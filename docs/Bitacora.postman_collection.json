              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Incluye WWW-Authenticate: Bearer', function () { pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'); });"
                ]
              }
            }
          ]
