          }
        }
      ]
    },
    {
      "name": "5. Crear registro (fallido - 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"ab\",\n  \"descripcion\": \"\",\n  \"fotoBase64\": \"no-es-base64!!!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/registros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "registros"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Problem details present', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('errors');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
