      "name": "0. Preparación (registro y login)",
      "item": [
        {
          "name": "0.1 Registrar Usuario A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{usuarioACorreo}}\",\n  \"password\": \"{{usuarioAPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 creado o 409 si ya existía', function () { pm.expect(pm.response.code).to.be.oneOf([201,409]); });",
                  "if (pm.response.code === 201) { pm.test('Rol Usuario y sin hash en la respuesta', function () { var j = pm.response.json(); pm.expect(j.rol).to.eql('Usuario'); pm.expect(j).to.not.have.property('passwordHash'); pm.expect(j).to.not.have.property('password'); }); }"
                ]
              }
            }
          ]
        },
