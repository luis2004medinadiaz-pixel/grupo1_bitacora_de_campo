            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Titulo actualizado', function () {",
              "    pm.expect(pm.response.json().titulo).to.eql('Registro actualizado');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
